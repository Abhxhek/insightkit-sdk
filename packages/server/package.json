{
  "name": "insightics-server",
  "version": "1.0.1",
  "private": true,
  "description": "The HTTP surface. Web-standard Request to Response, with thin adapters for Next, Express, Fastify and Hono. Where a request becomes a tenant and where an unscoped read is refused.",
  "keywords": [
    "insightics",
    "analytics",
    "text-to-sql",
    "postgres",
    "llm",
    "nextjs",
    "express",
    "fastify",
    "hono",
    "sse"
  ],
  "homepage": "https://github.com/Abhxhek/insightkit-sdk/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/Abhxhek/insightkit-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhxhek/insightkit-sdk.git",
    "directory": "packages/server"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "insightics-core": "workspace:*",
    "insightics-protocol": "workspace:*"
  }
}
