{
  "name": "insightics-sql-guard",
  "version": "1.0.1",
  "private": true,
  "description": "The Insightics security kernel: decides whether a SQL string is a safe read-only SELECT. Parses, validates against an allowlist, and re-emits the SQL from its own AST. Cannot connect to a database.",
  "keywords": [
    "insightics",
    "analytics",
    "text-to-sql",
    "postgres",
    "llm",
    "sql",
    "security",
    "read-only",
    "parser"
  ],
  "homepage": "https://github.com/Abhxhek/insightkit-sdk/tree/main/packages/sql-guard#readme",
  "bugs": {
    "url": "https://github.com/Abhxhek/insightkit-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhxhek/insightkit-sdk.git",
    "directory": "packages/sql-guard"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pgsql-parser": "18.2.6"
  }
}
