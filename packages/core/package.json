{
  "name": "insightics-core",
  "version": "1.0.1",
  "description": "The Insightics engine. Owns the two-role connection split, the sealed read-only transaction, and the isolation proofs. The only package that talks to a database.",
  "keywords": [
    "insightics",
    "analytics",
    "text-to-sql",
    "postgres",
    "llm",
    "sql",
    "read-only",
    "row-level-security"
  ],
  "homepage": "https://github.com/Abhxhek/insightkit-sdk/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Abhxhek/insightkit-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhxhek/insightkit-sdk.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "default": "./dist/pg.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke-pg.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "insightics-sql-guard": "workspace:*",
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "insightics-llm": "workspace:*",
    "pg": "^8.23.0",
    "pgsql-parser": "^18.2.6"
  }
}
