{
  "name": "@insightkit/core",
  "version": "0.0.0",
  "description": "The InsightKit engine. Owns the two-role connection split, the sealed read-only transaction, and the isolation proofs. The only package that talks to a database.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "default": "./dist/pg.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke-pg.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@insightkit/sql-guard": "workspace:*"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pg": "^8.23.0"
  }
}
