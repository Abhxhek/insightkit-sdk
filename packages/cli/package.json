{
  "name": "@insightkit/cli",
  "version": "0.0.0",
  "description": "ik init | doctor | introspect. A thin front end over the provisioning script and the isolation proofs core already exposes.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ik": "./dist/bin.js"
  },
  "exports": {
