{
  "name": "insightics-react",
  "version": "1.0.1",
  "private": true,
  "description": "The component a developer drops into an admin panel. Browser only: it talks to the server over HTTP and must never reach core.",
  "keywords": [
    "insightics",
    "analytics",
    "text-to-sql",
    "postgres",
    "llm",
    "react",
    "charts",
    "dashboard"
  ],
  "homepage": "https://github.com/Abhxhek/insightkit-sdk/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Abhxhek/insightkit-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhxhek/insightkit-sdk.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
