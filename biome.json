{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": ["**/*.ts", "**/*.tsx", "**/*.json", "!**/dist/**", "!**/node_modules/**", "!pnpm-lock.yaml"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noDefaultExport": "error", "useConst": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "overrides": [
    {
      "includes": ["**/*.config.ts", "**/*.config.mts", "**/.dependency-cruiser.cjs"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
