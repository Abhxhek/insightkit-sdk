{
  "name": "insightkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm lint:deps && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^24.13.3",
    "dependency-cruiser": "^17.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
